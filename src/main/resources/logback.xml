<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false" scan="false">

    <conversionRule conversionWord="splice" converterClass="io.github.ieshishinjin.splice.SpliceLogColor" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${SPLICE_COLOR:-%splice(%msg)}%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${user.home}/.splice/logs/splice.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="FILE" />
    </root>

    <logger name="io.github.ieshishinjin.splice" level="INFO">
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="ch.qos.logback" level="WARN" />
    <logger name="org.apache" level="WARN" />
    <logger name="org.objectweb" level="WARN" />
    <logger name="org.slf4j" level="WARN" />
</configuration>
